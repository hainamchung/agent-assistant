{
  "claude": {
    "PLATFORM_NAME": "Claude Code",
    "TOOL_PATH": ".claude",
    "BOOT_FILE": "CLAUDE.md",
    "TIER1_TOOL": "runSubagent",
    "capabilities": {
      "sub_agents": true,
      "terminal": true,
      "file_edit": true,
      "web_search": false,
      "mcp": true,
      "background_tasks": true,
      "max_context_tokens": 200000
    },
    "adapter_hints": {
      "tier_default": "full",
      "execution_model": "enhanced",
      "tool_alternatives": {
        "web_search": "Use terminal with curl for web requests"
      }
    },
    "formatting_hints": {
      "max_line_length": null,
      "heading_style": "atx",
      "emphasis_style": "bold_for_headers",
      "code_fence": "```",
      "section_separator": "---",
      "table_support": true,
      "collapsible_sections": false,
      "xml_tags": true,
      "emoji_in_headers": true,
      "notes": "XML tags preferred for structured data. Supports full markdown."
    }
  },
